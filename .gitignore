## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio framework tools.
# User-specific files
*.rstp
*.suo
*.vspscc
*.vsip
*.vcproj.*
*.user

# Build results
[dD]ebug/
[dD]elete
[eE]xported*
[oO]utput/
[rR]elease/
[bB]in/
[dD]ata/*.xsd
[dD]ata/*.xml
[dD]ata/*.html
[lL]ogs/*
[mM]sg/
[pP]atterns/
[tT]hrowaway/

# Optional: command line tools generated by .NET SDK
*.dll
*.exe
*.pdb
obj/
[xX]64/[bB]in/
[xX]86/[bB]in/

# VS / ReSharper cache files and folders
.vs/
.reSharper/
[dD]ebugger/

# Visual Studio cache files
# Ignore files in bin/
# Ignore *.user
# Ignore the obj folder
*/[oO]bj/
*/[bB]in/

# Ignored files
bin/
obj/
publish/

# IntelliJ files
.idea/

# Rider IDE
.rider/

# NuGet packages
packages/
*.nupkg
*.snupkg

# Visual Studio cache file
*.cache

# Visual Studio project node folder
.vs/

# ASP.NET Core
appsettings.Local.json
appsettings.Development.json

# Windows thumbnail cache
Thumbs.db
